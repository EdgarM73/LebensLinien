APP_REGISTRATION_KEY=replace-with-a-long-random-secret
BIND_ADDR=127.0.0.1
PORT=3000
COOKIE_SECURE=false
# Optional comma-separated Gramps server host allowlist:
# APP_ALLOWED_GRAMPS_HOSTS=gramps.example.org
# Number of own reverse proxies in front of the app (0 = none). Needed so the
# sign-in rate limit counts per visitor instead of per proxy:
# APP_TRUSTED_PROXIES=1
# Delete videos and preview images after this many days (0 = keep until replaced):
# APP_VIDEO_RETENTION_DAYS=30
